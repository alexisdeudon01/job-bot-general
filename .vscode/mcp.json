{
	"servers": {
		"io.github.ScrapeGraphAI/scrapegraph-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"scrapegraph-mcp@1.0.1"
			],
			"env": {
				"SGAI_API_KEY": "${input:sgaiApiKey}"
			},
		},
		"job-bot-mcp-host": {
			"type": "stdio",
			"command": "python",
			"args": [
				"-m",
				"mcp_host.main",
				"--list-tools"
			],
			"env": {
				"PYTHONPATH": "${workspaceFolder}",
				"OPENAI_API_KEY": "${input:openaiApiKey}",
				"SGAI_API_KEY": "${input:sgaiApiKey}",
				"GH_TOKEN": "${input:ghToken}",
				"DATABASE_URL": "${input:databaseUrl}"
			},
		},
		"modelcontextprotocol/fetch": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"mcp-server-fetch"
			]
		},
		"modelcontextprotocol/filesystem": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}",
				"${workspaceFolder}/data",
				"${workspaceFolder}/output",
				"${workspaceFolder}/docs"
			]
		},
		"modelcontextprotocol/github": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-github"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${input:ghToken}"
			}
		},
		"modelcontextprotocol/postgres": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"${input:databaseUrl}"
			]
		}
	},
	"inputs": [
		{
			"id": "sgaiApiKey",
			"type": "promptString",
			"description": "ScrapeGraph API key (SGAI_API_KEY)"
		},
		{
			"id": "openaiApiKey",
			"type": "promptString",
			"description": "OpenAI API key (OPENAI_API_KEY)"
		},
		{
			"id": "ghToken",
			"type": "promptString",
			"description": "GitHub Personal Access Token (GH_TOKEN)"
		},
		{
			"id": "databaseUrl",
			"type": "promptString",
			"description": "PostgreSQL URL (ex: postgresql://postgres:postgres@localhost:5432/job_bot_general)",
			"default": "postgresql://postgres:postgres@localhost:5432/job_bot_general"
		}
	]
}